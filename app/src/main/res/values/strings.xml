<?xml version="1.0" encoding="utf-8"?>
<!--
    Numbers are always passed in as text (%1$s), never as %d: Android would write
    them with Farsi digits, and Tik uses English digits everywhere.
    User text inside a sentence (a list name, a search) sits between U+2068 and
    U+2069, so an English name keeps its place in a Farsi sentence and the other way round.
-->
